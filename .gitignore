# .gitignore — Danh sách file/thư mục KHÔNG đưa vào bộ nộp
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environment
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store
desktop.ini

# Dữ liệu runtime (sinh ra khi chạy, không cần nộp)
data/surveillance.db
evidence/records/
evidence/crops/

# Model trùng lặp (chỉ giữ models/best.pt & models/best.onnx)
models/best (*).pt
models/best_*.pt
models/best_*.onnx

# Dataset Roboflow (tải lại bằng script datasets/download_dataset.py)
sidewalk-signboard-detection*/
datasets/raw_images/
datasets/*/train/
datasets/*/valid/
datasets/*/test/
runs/

# Log & Temp
*.log
*.tmp
*.zip
scratch/
